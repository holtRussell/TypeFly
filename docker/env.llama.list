# llama.cpp Environment Variables
# ================================

# llama.cpp Server API Configuration
LLAMA_SERVER_URL=http://localhost:8080/v1
LLAMA_SERVER_API_KEY=token-abc123

# HuggingFace (for downloading models)
# HF_TOKEN=your_huggingface_token_here

# Python Environment
PYTHONPATH=/workspace

# Optional: llama.cpp Performance Settings
# GGML_METAL_ENABLED=1 (already set in docker-compose)
# See: https://github.com/ggerganov/llama.cpp/tree/master/examples/server